{
  "name": "@repo/data-ops",
  "version": "1.0.0",
  "description": "Manage auth, database, schemas, and queries",
  "exports": {
    "./auth/*": {
      "default": "./dist/auth/*.js",
      "types": "./dist/auth/*.d.ts"
    },
    "./database/*": {
      "default": "./dist/database/*.js",
      "types": "./dist/database/*.d.ts"
    },
    "./zod-schema/*": {
      "default": "./dist/zod-schema/*.js",
      "types": "./dist/zod-schema/*.d.ts"
    },
    "./queries/*": {
      "default": "./dist/queries/*.js",
      "types": "./dist/queries/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir ./dist && tsc-alias",
    "typecheck": "tsc --noEmit",
    "better-auth:generate": "better-auth generate --config ./config/auth.ts --output ./src/drizzle/auth-schema.ts --yes",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "drizzle:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "drizzle:pull": "drizzle-kit pull --config drizzle.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@planetscale/database": "^1.19.0",
    "@polar-sh/better-auth": "^1.1.0",
    "@polar-sh/sdk": "^0.34.13",
    "better-auth": "1.6.29",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260820.1",
    "@types/better-sqlite3": "^7.6.13",
    "@better-auth/cli": "1.4.21",
    "drizzle-kit": "0.31.10",
    "mysql2": "^3.14.3",
    "postgres": "^3.4.7",
    "tsc-alias": "^1.8.16",
    "typescript": "5.9.3"
  }
}
